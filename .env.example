# ─── Server-only ──────────────────────────────────────────────────────────────
# Never prefix these with NEXT_PUBLIC_: that would inline them into the client
# bundle and publish the credential.

# Base URL of the CommonsDB registry API this app proxies.
REGISTRY_API_URL=https://api.commonsdb.org

# Bearer token for the registry API. Required — the API routes return 500 without it.
REGISTRY_API_TOKEN=x

# ─── Public ───────────────────────────────────────────────────────────────────
# Inlined into the client bundle at build time. Public by definition.

# ISCC generation service, used by the explorer's drag-and-drop file search.
# Leave empty to disable file-based search.
NEXT_PUBLIC_ISCC_SERVICE_URL=x

# Public metadata API base, used to build citable declaration links.
NEXT_PUBLIC_METADATA_PUBLIC_URL=https://api.commonsdb.org/v1/metadata-pub
